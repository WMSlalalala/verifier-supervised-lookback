% NC State theme. Colors from brand.ncsu.edu/designing-for-nc-state/color/
% Core: Wolfpack Red #CC0000 (predominant), Wolfpack Black, Wolfpack White.
% Expanded (subordinate): Carmichael Aqua tint #2db597, Bio-Indigo #4156a1.
\ProvidesPackage{beamerthemencsu}[2026/11/22 NC State beamer theme]
\mode<presentation>
\definecolor{wolfred}{HTML}{CC0000}
\definecolor{reynolds}{HTML}{990000}
\definecolor{wolfblack}{HTML}{000000}
\definecolor{ncgray}{HTML}{4D4D4D}
\definecolor{nclight}{HTML}{F2F2F2}
\definecolor{ncaqua}{HTML}{2DB597}
\definecolor{ncindigo}{HTML}{4156A1}
\setbeamercolor{structure}{fg=wolfred}
\setbeamercolor{frametitle}{fg=wolfblack,bg=white}
\setbeamercolor{title}{fg=white}
\setbeamercolor{normal text}{fg=wolfblack}
\setbeamercolor{alerted text}{fg=wolfred}
\setbeamercolor{itemize item}{fg=wolfred}
\setbeamercolor{itemize subitem}{fg=ncgray}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\footnotesize$\blacksquare$}}
\setbeamertemplate{itemize subitem}{\textendash}
% red rule under every frame title
\setbeamertemplate{frametitle}{%
  \vspace{0.45em}\hspace{0.9em}\insertframetitle%
  \vspace{0.18em}\par\hspace{0.9em}{\color{wolfred}\rule{0.955\paperwidth}{1.6pt}}\par}
% footer: red bar with slide number
\setbeamertemplate{footline}{%
  \hbox{\begin{beamercolorbox}[wd=\paperwidth,ht=1.55ex,dp=1.0ex,leftskip=.9em,rightskip=.9em]{}%
  \color{ncgray}\scriptsize\insertshorttitle\hfill\insertframenumber\end{beamercolorbox}}}
\mode<all>
